smt_info_size = input.string(size.normal, "Text Size", group=GRP_INFO, options=[size.tiny, size.small, size.normal, size.large])
smt_info_text_c = input.color(color.new(color.black, 0),   "Text Color", group=GRP_INFO)
smt_info_bg_c   = input.color(color.new(color.white, 100), "Background", group=GRP_INFO)

//#region [CONSTANTS AND STATE]

candleSpacing = 3
noColor       = color.new(#000000, 100)

type HtfCandle
    float o
    float h
    float l
    float c
    int   hBar
    int   lBar
    box   body
    line  wickUp
    line  wickDown
    line  eqLine
    int   midX
    line  sweepLine   = na
    bool  triggerBuy  = false
    bool  triggerSell = false
    int   openTime    = na
    label timeLbl      = na

type PeriodState
    float prevHigh        = na
    float prevLow         = na
    int   prevHighBar     = na
    int   prevLowBar      = na
    float prevPrevHigh    = na
    float prevPrevLow     = na
    int   prevPrevHighBar = na
    int   prevPrevLowBar  = na
    bool  prevC2Buy       = false
    bool  prevC2Sell      = false

type StdDevData
    array<line>  lines
    array<label> labels

type C2Setup
    bool  isBull
    float extreme
    int   phase     = 1
    bool  dead      = false
    label c2Lbl
    int   c2BarIndex    = na
    box   c3Box     = na
    line  c3Dash    = na
    label c3Lbl     = na
    float cisdLevel     = na
    int   cisdIndex     = na
    bool  cisdConfirmed = false
    line  cisdLine      = na
    label cisdLabel     = na
    StdDevData stdDevData = na
    box   c4Box     = na
    line  c4Dash    = na
    label c4Lbl     = na
    float c4Top     = na
    float c4Bottom  = na
    bool  c4Invalid = false

type SetupRecord
    C2Setup setup
    int     creationBar

type EarlyCisdRecord
    line  ln
    label lbl
    int   barIndex

var array<HtfCandle>        htfCandles           = array.new<HtfCandle>()
var array<HtfCandle>        htf2Candles          = array.new<HtfCandle>()
var array<HtfCandle>        htf3Candles          = array.new<HtfCandle>()
var array<line>             vLines               = array.new<line>()
var array<line>             hLines               = array.new<line>()
var array<line>             lLines               = array.new<line>()
var array<line>             c1SweepLines         = array.new<line>()   // <-- new
var PeriodState              state                = PeriodState.new()
var C2Setup                  buySetup             = na
var C2Setup                  sellSetup            = na
var array<SetupRecord>       setupRecords         = array.new<SetupRecord>()
var array<EarlyCisdRecord>   bullEarlyCisdRecords = array.new<EarlyCisdRecord>()
var array<EarlyCisdRecord>   bearEarlyCisdRecords = array.new<EarlyCisdRecord>()
var int                      htfOpenBar           = na
var line                     htfOpenLn            = na
var label                    htfInfoLbl           = na
var label                    htf2InfoLbl          = na
var label                    htf3InfoLbl          = na

allowBuy  = biasFilter != 'Bearish'
allowSell = biasFilter != 'Bullish'

var array<line>  bslLines   = array.new<line>()
var array<label> bslLabels  = array.new<label>()
var array<float> bslPrices  = array.new<float>()
var array<bool>  bslSwept   = array.new<bool>()

var array<line>  sslLines   = array.new<line>()
var array<label> sslLabels  = array.new<label>()
var array<float> sslPrices  = array.new<float>()
var array<bool>  sslSwept   = array.new<bool>()

//#endregion

//#region [FUNCTIONS]

tfLabel(string tf) =>
    switch tf
        '1'   => '1m'
        '2'   => '2m'
        '3'   => '3m'
        '5'   => '5m'
        '15'  => '15m'
        '30'  => '30m'
        '60'  => '1H'
        '90'  => '90m'     // <-- new
        '240' => '4H'
        '360' => '6H'
        '1D'  => '1D'
        'D'   => '1D'
        '1W'  => '1W'
        'W'   => '1W'
        '1M'  => '1M'
        '3M'  => '3M'      // <-- new
        '6M'  => '6M'      // <-- new
        '12M' => '12M'     // <-- new
        =>       tf + 'm'

tfMins(string tf) =>
    switch tf
        '1D' => 1440
        'D'  => 1440
        '1W' => 10080
        'W'  => 10080
        '1M' => 43200
        'M'  => 43200
        '3M' => 129600     // <-- new: 3 * 43200
        '6M' => 259200     // <-- new: 6 * 43200
        '12M' => 518400    // <-- new: 12 * 43200
        =>      int(str.tonumber(tf))

curTfCode() =>
    timeframe.isdaily ? '1D' : timeframe.isweekly ? '1W' : timeframe.ismonthly ? '1M' : timeframe.period

tablePosition(string vert, string horz) =>
    switch vert + '-' + horz
        'Top-Left'      => position.top_left
        'Top-Center'    => position.top_center
        'Top-Right'     => position.top_right
        'Middle-Left'   => position.middle_left
        'Middle-Center' => position.middle_center
        'Middle-Right'  => position.middle_right
        'Bottom-Left'   => position.bottom_left
        'Bottom-Center' => position.bottom_center
        'Bottom-Right'  => position.bottom_right
        =>                 position.top_right

lineStyleFromStr(string s) =>
    switch s
        'Solid'  => line.style_solid
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        =>          line.style_dashed

textSize(string s) =>
    switch s
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        =>          size.huge

directionalLabel(int xBar, float yPrice, string txt, bool bullish) =>
    label.new(xBar, yPrice, text = txt, xloc = xloc.bar_index, yloc = yloc.price, style = bullish ? label.style_label_up : label.style_label_down, color = na, textcolor = c2c3c4Color, size = textSize(labelSize), text_font_family = font.family_default)

eqLineColor() => showEQ ? eqColor : noColor

pad2(int v) =>
    v < 10 ? '0' + str.tostring(v) : str.tostring(v)

formatRemaining(int ms, bool forceHours) =>
    totalSec = int(math.max(ms, 0) / 1000)
    dd = int(totalSec / 86400)
    hh = int((totalSec % 86400) / 3600)
    mm = int((totalSec % 3600) / 60)
    ss = int(totalSec % 60)
    if forceHours and dd > 0
        str.tostring(dd) + 'D ' + pad2(hh) + ':' + pad2(mm) + ':' + pad2(ss)
    else if forceHours
        pad2(hh) + ':' + pad2(mm) + ':' + pad2(ss)
    else
        pad2(mm) + ':' + pad2(ss)

drawSweepLine(int fromBar, float fromPrice, int toBar) =>
    if showSweep
        ln = line.new(fromBar, fromPrice, toBar, fromPrice, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth)
        c1SweepLines.push(ln)
        while c1SweepLines.size() > sweepHistory
            line.delete(c1SweepLines.shift())

newLHLine(float price) =>
    line.new(bar_index, price, bar_index, price, xloc.bar_index, extend.none, lhColor, lineStyleFromStr(lhStyle), lhWidth)

updateLHLine(line ln, float price) =>
    line.set_xy1(ln, line.get_x1(ln), price)
    line.set_xy2(ln, bar_index, price)
    line.set_color(ln, lhColor)
    line.set_style(ln, lineStyleFromStr(lhStyle))
    line.set_width(ln, lhWidth)

// AUTOMATIC — original fractal chain extended one level up
// Examples: 1m → 15m → 4H   |   3m → 30m → 90m   |   1H → 1D → 1W
// ----------------------------------------------------------------
autoHTF() =>
    int    tf_sec     = timeframe.in_seconds()
    bool   is_1w_chart = timeframe.isweekly and timeframe.multiplier == 1
    bool   is_1m_chart = timeframe.ismonthly and timeframe.multiplier == 1
    string result =
     tf_sec == 60    ? "15"  :
     tf_sec == 120   ? "15"  :
     tf_sec == 180   ? "30"  :
     tf_sec == 300   ? "60"  :
     tf_sec == 900   ? "240" :
     tf_sec == 1800  ? "90"  :
     tf_sec == 3600  ? "1D"  :
     tf_sec == 14400 ? "1W"  :
     tf_sec == 86400 ? "1M"  :
     is_1w_chart      ? "3M"  :
     is_1m_chart      ? "6M"  :
     tf_sec < 3600    ? "60"  : "1D"
    result

ltfCode() =>
    switch modelType
        '1m-15m' => '1'
        '2m-20m' => '2'
        '3m-30m' => '3'
        '5m-1H'  => '5'
        '15m-4H' => '15'
        '30m-6H' => '30'
        '1H-1D'  => '60'
        '4H-1W'  => '240'
        '1D-1W'  => '1D'
        'Custom' => customLTF
        =>          curTfCode()

isAutoValidTf(int mins) => mins == 1 or mins ==2 or mins == 3 or mins == 5 or mins == 15 or mins == 30 or mins == 60 or mins == 90 or mins == 240 or mins ==360 or mins == 1440 or mins == 10080 or mins ==129600 or mins == 259200 or mins == 518400

method delete(HtfCandle c) =>
    box.delete(c.body)
    line.delete(c.wickUp)
    line.delete(c.wickDown)
    line.delete(c.eqLine)
    line.delete(c.sweepLine)
    if not na(c.timeLbl)
        label.delete(c.timeLbl)

method update(HtfCandle c, float curH, float curL, float curC, int curBar) =>
    if curH > c.h
        c.h    := curH
        c.hBar := curBar
    if curL < c.l
        c.l    := curL
        c.lBar := curBar
    c.c := curC
    c

method draw(HtfCandle c, int leftBar, string tf = "") => 
    bool  isBull = c.c >= c.o
    int   midX   = leftBar + 1
    float eq     = (c.h + c.l) / 2
    box.set_left(c.body, leftBar)
    box.set_right(c.body, leftBar + 2)
    box.set_top(c.body, math.max(c.o, c.c))
    box.set_bottom(c.body, math.min(c.o, c.c))
    box.set_bgcolor(c.body, isBull ? bullBody : bearBody)
    box.set_border_color(c.body, isBull ? borderBull : borderBear)
    line.set_x1(c.wickUp, midX)
    line.set_x2(c.wickUp, midX)
    line.set_y1(c.wickUp, c.h)
    line.set_y2(c.wickUp, math.max(c.o, c.c))
    line.set_color(c.wickUp, isBull ? wickBull : wickBear)
    line.set_x1(c.wickDown, midX)
    line.set_x2(c.wickDown, midX)
    line.set_y1(c.wickDown, c.l)
    line.set_y2(c.wickDown, math.min(c.o, c.c))
    line.set_color(c.wickDown, isBull ? wickBull : wickBear)
    line.set_x1(c.eqLine, midX)
    line.set_x2(c.eqLine, midX)
    line.set_y1(c.eqLine, eq)
    line.set_y2(c.eqLine, eq)
    line.set_color(c.eqLine, eqLineColor())
    line.set_style(c.eqLine, lineStyleFromStr(eqStyle))
    line.set_width(c.eqLine, eqWidth)
    c.midX := midX

    string timeText = ""
    if tf == "" or timeframe.in_seconds(tf) >= timeframe.in_seconds("1D")
        int labelTime = c.openTime + 12 * 60 * 60 * 1000
        timeText := str.upper(str.format_time(labelTime, "EEE", "America/New_York"))
    else
        timeText := str.format_time(c.openTime, "HH:mm", "America/New_York")

    if showHtfStamps
        if na(c.timeLbl)
            c.timeLbl := label.new(midX, c.l, timeText,
                 xloc = xloc.bar_index, yloc = yloc.price,
                 style = label.style_label_up,
                 color = na,
                 textcolor = htfInfoColor,
                 size = textSize(labelSize),
                 text_font_family = font.family_default)
        else
            label.set_xy(c.timeLbl, midX, c.l)
            label.set_text(c.timeLbl, timeText)
            label.set_textcolor(c.timeLbl, htfInfoColor)
            label.set_size(c.timeLbl, textSize(labelSize))
    else if not na(c.timeLbl)
        label.delete(c.timeLbl)
        c.timeLbl := na

    c.midX := midX

newHtfCandle() =>
    HtfCandle.new(open, high, low, close, bar_index, bar_index,
         box.new(bar_index, high, bar_index, low, border_color = borderBull, border_width = 1),
         line.new(bar_index, high, bar_index, high, color = wickBull),
         line.new(bar_index, low, bar_index, low, color = wickBull),
         line.new(bar_index, high, bar_index, high, color = noColor),
         na, openTime = time)

getExtraHTFs() =>
    string tf2 = na
    string tf3 = na
    switch timeframe.period
        '1'  =>
            tf2 := '30'
            tf3 := '60'
        '2'  =>
            tf2 := '30'
            tf3 := '60'
        '3'  =>
            tf2 := '60'
            tf3 := '240'
        '5'  =>
            tf2 := '240'
            tf3 := '1D'
        '15' =>
            tf2 := '360'
            tf3 := '1D'
        '30' =>
            tf2 := '1D'
            tf3 := '1W'
        '60' =>
            tf2 := '1W'
            tf3 := '1M'
        '240' =>
            tf2 := '1M'
            tf3 := '3M'
        '1D' =>
            tf2 := '3M'
            tf3 := na
        =>
            tf2 := na
            tf3 := na
    [tf2, tf3]

manageExtraHTF(array<HtfCandle> candles, string tf, int maxCount) =>
    if na(tf)
        candles
    else
        bool changed = time(tf) != time(tf)[1]
        if changed
            candles.unshift(newHtfCandle())
            while candles.size() > maxCount
                candles.pop().delete()
        else if candles.size() > 0
            candles.set(0, candles.first().update(high, low, close, bar_index))
        candles

drawEarlyCisd(bool isBull, float level, int idx, int confirmBar) =>
    array<EarlyCisdRecord> target = isBull ? bullEarlyCisdRecords : bearEarlyCisdRecords
    color clr = isBull ? earlyCisdBullColor : earlyCisdBearColor
    if showEarlyCisd
        ln = line.new(idx, level, confirmBar + 3, level, color = clr, style = lineStyleFromStr(earlyCisdStyle), width = earlyCisdWidth)
        label lbl = na
        if showLabels
            lbl := label.new(confirmBar + 3, level, isBull ? '+CISD' : '-CISD', xloc = xloc.bar_index, style = label.style_label_left, color = na, textcolor = clr, size = textSize(labelSize), text_font_family = font.family_default)
        target.push(EarlyCisdRecord.new(ln, lbl, confirmBar))
    if showAlerts and showEarlyCisdAlerts
        alert((isBull ? 'Bullish' : 'Bearish') + ' Early CISD confirmed on ' + syminfo.ticker, alert.freq_once_per_bar)

pruneEarlyCisd(array<EarlyCisdRecord> recs, int thresholdBar) =>
    if not na(thresholdBar)
        while recs.size() > 0 and recs.first().barIndex < thresholdBar
            evicted = recs.shift()
            line.delete(evicted.ln)
            if not na(evicted.lbl)
                label.delete(evicted.lbl)

consumeLastEarlyCisd(array<EarlyCisdRecord> recs) =>
    if recs.size() > 0
        evicted = recs.pop()
        line.delete(evicted.ln)
        if not na(evicted.lbl)
            label.delete(evicted.lbl)

parseFloats(string src) =>
    var out = array.new<float>()
    array.clear(out)
    for part in str.split(str.replace_all(src, ' ', ''), ',')
        v = str.tonumber(part)
        if not na(v)
            out.push(v)
    out

createStdDevProjections(C2Setup s, int confirmBar) =>
    if showStdDev
        devs = parseFloats(stdDevInput)
        if devs.size() > 0
            level0 = s.cisdLevel
            level1 = s.extreme
            if stdDevCalc != 'Wick'
                for j = 0 to 50
                    if s.isBull ? low[j] == s.extreme : high[j] == s.extreme
                        level1 := s.isBull ? math.min(open[j], close[j]) : math.max(open[j], close[j])
                        break

            rightBar   = s.c2BarIndex
            priceRange = s.isBull ? level0 - level1 : level1 - level0
            lns        = array.new<line>()
            lbs        = array.new<label>()

            for dev in devs
                devPrice = s.isBull ? level0 - priceRange * dev : level0 + priceRange * dev
                if showLabels
                    lbs.push(label.new(rightBar, devPrice, str.tostring(dev), xloc = xloc.bar_index, style = label.style_label_center, color = na, textcolor = stdDevColor, size = textSize(labelSize), text_font_family = font.family_default))

            s.stdDevData := StdDevData.new(lns, lbs)

confirmCisd(C2Setup s, int confirmBar) =>
    s.cisdConfirmed := true
    showLine = s.isBull ? showBullCisd : showBearCisd
    clr      = s.isBull ? cisdBullColor : cisdBearColor
    lnStyle  = s.isBull ? cisdBullStyle : cisdBearStyle
    lnWidth  = s.isBull ? cisdBullWidth : cisdBearWidth
    if showLine
        s.cisdLine := line.new(s.cisdIndex, s.cisdLevel, confirmBar + 3, s.cisdLevel, color = clr, style = lineStyleFromStr(lnStyle), width = lnWidth)
    createStdDevProjections(s, confirmBar)

deleteSetupVisuals(C2Setup s) =>
    if not na(s)
        if not na(s.c2Lbl)
            label.delete(s.c2Lbl)
        if not na(s.cisdLine)
            line.delete(s.cisdLine)
        if not na(s.cisdLabel)
            label.delete(s.cisdLabel)
        if not na(s.c3Box)
            box.delete(s.c3Box)
        if not na(s.c3Dash)
            line.delete(s.c3Dash)
        if not na(s.c3Lbl)
            label.delete(s.c3Lbl)
        if not na(s.c4Box)
            box.delete(s.c4Box)
        if not na(s.c4Dash)
            line.delete(s.c4Dash)
        if not na(s.c4Lbl)
            label.delete(s.c4Lbl)
        if not na(s.stdDevData)
            if not na(s.stdDevData.lines)
                for ln in s.stdDevData.lines
                    line.delete(ln)
            if not na(s.stdDevData.labels)
                for lb in s.stdDevData.labels
                    label.delete(lb)

registerRecord(C2Setup s) =>
    setupRecords.push(SetupRecord.new(s, bar_index))
    while showHistory > 0 and setupRecords.size() > showHistory
        evicted = setupRecords.shift()
        deleteSetupVisuals(evicted.setup)
    earliestVisibleBar = setupRecords.size() > 0 ? setupRecords.first().creationBar : na
    pruneEarlyCisd(bullEarlyCisdRecords, earliestVisibleBar)
    pruneEarlyCisd(bearEarlyCisdRecords, earliestVisibleBar)

autoTf = switch modelType
    '1m-15m' => '15'
    '2m-20m' => '20'
    '3m-30m' => '30'
    '5m-1H'  => '60'
    '15m-4H' => '240'
    '30m-6H' => '360'
    '1H-1D'  => '1D'
    '4H-1W'  => '1W'
    '1D-1W'  => '1W'
    'Custom' => customHTF
    =>          autoHTF()

validTf = modelType == 'Auto' ? isAutoValidTf(tfMins(curTfCode())) : tfMins(curTfCode()) <= tfMins(ltfCode())

[currentO, currentH, currentL, currentC, prevH1, prevL1] = request.security(syminfo.tickerid, autoTf, [open[0], high[0], low[0], close[0], high[1], low[1]], lookahead = barmerge.lookahead_on)

c2Buy         = currentL < prevL1 and currentC > prevL1
c2Sell        = currentH > prevH1 and currentC < prevH1
periodChanged = time(autoTf) != time(autoTf)[1]

drawPhase(bool isBull, bool isC4) =>
    mid   = (state.prevHigh + state.prevLow) / 2
    top   = math.max(open, mid)
    bot   = math.min(open, mid)
    yDash = isBull ? bot : top
    bxCol = isBull ? tSpotBullColor : tSpotBearColor
    box   bx   = showTSpot ? box.new(bar_index, top, bar_index, bot, border_color = na, bgcolor = bxCol) : na
    line  dash = showEQ ? line.new(bar_index, yDash, bar_index, yDash, color = eqColor, width = eqWidth, style = lineStyleFromStr(eqStyle)) : na
    label lbl  = na
    if showTSpot and showLabels and validTf
        lbl := directionalLabel(bar_index + 2, isBull ? bot : top, isC4 ? 'C4' : 'C3', isBull)
    [bx, dash, lbl, top, bot]

newSetup(bool isBull, float extreme, label c2Lbl, float cisdLevel, int cisdIndex, bool cisdAlreadyConfirmed, int cisdConfirmBar, int c2BarIndex) =>
    s = C2Setup.new(isBull, extreme, 1, false, c2Lbl)
    s.c2BarIndex := c2BarIndex
    [bx, dash, lbl, _, _] = drawPhase(isBull, false)
    s.c3Box     := bx
    s.c3Dash    := dash
    s.c3Lbl     := lbl
    s.cisdLevel := cisdLevel
    s.cisdIndex := cisdIndex
    if cisdAlreadyConfirmed and not na(cisdLevel) and not na(cisdIndex) and not na(cisdConfirmBar)
        confirmCisd(s, cisdConfirmBar)
    registerRecord(s)
    s

method advanceToC4(C2Setup s) =>
    if not na(s.c3Box)
        box.set_right(s.c3Box, bar_index)
        line.set_x2(s.c3Dash, bar_index)
    [bx, dash, lbl, top, bot] = drawPhase(s.isBull, true)
    s.c4Box     := bx
    s.c4Dash    := dash
    s.c4Lbl     := lbl
    s.c4Top     := top
    s.c4Bottom  := bot
    s.phase     := 2
    s.c4Invalid := false
    s

method finish(C2Setup s) =>
    if not na(s.c4Box)
        box.set_right(s.c4Box, bar_index)
        line.set_x2(s.c4Dash, bar_index)
    s.phase := 0
    s

method deleteStdDev(C2Setup s) =>
    if not na(s.stdDevData)
        if not na(s.stdDevData.lines)
            for ln in s.stdDevData.lines
                line.delete(ln)
        if not na(s.stdDevData.labels)
            for lb in s.stdDevData.labels
                label.delete(lb)
        s.stdDevData := na
    s

method extendAndCheck(C2Setup s) =>
    if not na(s) and not s.dead and s.phase != 0
        box  extBox  = s.phase == 1 ? s.c3Box : s.c4Box
        line extDash = s.phase == 1 ? s.c3Dash : s.c4Dash
        if not na(extBox)
            box.set_right(extBox, bar_index)
            line.set_x2(extDash, bar_index)

        c2Breach = s.isBull ? low < s.extreme : high > s.extreme
        if c2Breach
            if not na(s.c2Lbl)
                label.set_text(s.c2Lbl, 'XC2')
                label.set_textcolor(s.c2Lbl, s.phase == 2 ? color.orange : color.red)
            if not na(s.c3Box)
                box.delete(s.c3Box)
                s.c3Box := na
            if not na(s.c3Dash)
                line.delete(s.c3Dash)
                s.c3Dash := na
            if not na(s.c3Lbl)
                label.delete(s.c3Lbl)
                s.c3Lbl := na
            if not na(s.c4Box)
                box.delete(s.c4Box)
                s.c4Box := na
            if not na(s.c4Dash)
                line.delete(s.c4Dash)
                s.c4Dash := na
            if not na(s.c4Lbl)
                label.delete(s.c4Lbl)
                s.c4Lbl := na
            s.deleteStdDev()
            s.dead  := true
            s.phase := 0
    s

method checkC4Invalid(C2Setup s) =>
    if not na(s) and not s.dead and s.phase == 2 and not s.c4Invalid
        invalid = s.isBull ? close[1] < s.c4Bottom : close[1] > s.c4Top
        if invalid
            s.c4Invalid := true
            if not na(s.c4Lbl)
                label.set_text(s.c4Lbl, 'XC4')
                label.set_textcolor(s.c4Lbl, color.red)
            if not na(s.c4Dash)
                line.set_color(s.c4Dash, color.red)
            if not na(s.c4Box)
                box.delete(s.c4Box)
                s.c4Box := na
    s

method checkCisdConfirm(C2Setup s) =>
    if not na(s) and not s.dead and not s.cisdConfirmed and s.phase != 0 and not na(s.cisdLevel) and not na(s.cisdIndex)
        confirmed = s.isBull ? close > s.cisdLevel : close < s.cisdLevel
        if confirmed
            confirmCisd(s, bar_index)
    s

processC2(bool trigger, bool allow, bool isBull, float extremePrice, int extremeBar, float sweepFromPrice, int sweepFromBar, float cisdLevel, int cisdIndex, bool cisdAlreadyConfirmed, int cisdConfirmBar, C2Setup existing) =>
    C2Setup result = existing
    if trigger and allow
        label lbl = (validTf and showLabels) ? directionalLabel(extremeBar, extremePrice, 'C2', isBull) : na
        drawSweepLine(sweepFromBar, sweepFromPrice, bar_index)
        result := newSetup(isBull, extremePrice, lbl, cisdLevel, cisdIndex, cisdAlreadyConfirmed, cisdConfirmBar, extremeBar)
    else if periodChanged and not na(existing) and not existing.dead
        result := existing.phase == 1 ? existing.advanceToC4() : existing.phase == 2 ? existing.finish() : existing
    result

markTrigger(bool trigger, bool allow, int idx, bool isBuy) =>
    if trigger and allow and htfCandles.size() > idx
        c = htfCandles.get(idx)
        if isBuy
            c.triggerBuy := true
        else
            c.triggerSell := true

//#endregion

//#region [LOGIC]

var float o0 = open
var float h0 = high
var float l0 = low
var float o1 = open
var float h1 = high
var float l1 = low

if periodChanged
    o1 := o0[1]
    h1 := h0[1]
    l1 := l0[1]
    o0 := open
    h0 := high
    l0 := low

if high >= h0
    h0 := high
if low <= l0
    l0 := low

bool up = close > open
bool dw = close < open
bool eq = close == open

var float bullLevelFixed = na
var int   bullIndexFixed = na
var float bearLevelFixed = na
var int   bearIndexFixed = na

if low == l0 and low < l1
    if (dw[0] or eq[0]) and (up[1] or eq[1]) and not (eq[0] and eq[1])
        bullLevelFixed := open
        bullIndexFixed := bar_index
    else
        for i = 2 to 10
            if low[i] < low
                break
            if (up[i] or eq[i]) and dw[i - 1]
                b = i - 1
                bullLevelFixed := open[b]
                bullIndexFixed := bar_index - b
                for j = b to 0
                    if open[j] > bullLevelFixed and dw[j]
                        bullLevelFixed := open[j]
                        bullIndexFixed := bar_index - j
                if bullLevelFixed < open
                    bullLevelFixed := close > open ? high : open
                    bullIndexFixed := bar_index
                break

if high == h0 and high > h1
    if (up[0] or eq[0]) and (dw[1] or eq[1]) and not (eq[0] and eq[1])
        bearLevelFixed := open
        bearIndexFixed := bar_index
    else
        for i = 2 to 10
            if high[i] > high
                break
            if (dw[i] or eq[i]) and up[i - 1]
                yb = i - 1
                bearLevelFixed := open[yb]
                bearIndexFixed := bar_index - yb
                for j = yb to 0
                    if open[j] < bearLevelFixed and up[j]
                        bearLevelFixed := open[j]
                        bearIndexFixed := bar_index - j
                if bearLevelFixed > open
                    bearLevelFixed := close < open ? low : open
                    bearIndexFixed := bar_index
                break

var bool bullReclaimed  = false
var int  bullReclaimBar = na
var bool bearReclaimed  = false
var int  bearReclaimBar = na

bullPeriodSweep = l0 < l1
bearPeriodSweep = h0 > h1

newBullLevel = not na(bullIndexFixed) and (na(bullIndexFixed[1]) or bullIndexFixed != bullIndexFixed[1])
if newBullLevel
    bullReclaimed  := false
    bullReclaimBar := na
if not na(bullLevelFixed) and not bullReclaimed and close > bullLevelFixed
    bullReclaimed  := true
    bullReclaimBar := bar_index
    if bullPeriodSweep
        drawEarlyCisd(true, bullLevelFixed, bullIndexFixed, bar_index)

newBearLevel = not na(bearIndexFixed) and (na(bearIndexFixed[1]) or bearIndexFixed != bearIndexFixed[1])
if newBearLevel
    bearReclaimed  := false
    bearReclaimBar := na
if not na(bearLevelFixed) and not bearReclaimed and close < bearLevelFixed
    bearReclaimed  := true
    bearReclaimBar := bar_index
    if bearPeriodSweep
        drawEarlyCisd(false, bearLevelFixed, bearIndexFixed, bar_index)

candleOffset = candleOffsetIn + 10

if periodChanged
    if htfCandles.size() > 0
        newest             = htfCandles.first()
        state.prevHigh    := newest.h
        state.prevLow     := newest.l
        state.prevHighBar := newest.hBar
        state.prevLowBar  := newest.lBar
    if htfCandles.size() > 1
        prior                  = htfCandles.get(1)
        state.prevPrevHigh    := prior.h
        state.prevPrevLow     := prior.l
        state.prevPrevHighBar := prior.hBar
        state.prevPrevLowBar  := prior.lBar
    htfCandles.unshift(newHtfCandle())
    while htfCandles.size() > htfCandleCount
        htfCandles.pop().delete()
    htfOpenBar := bar_index
    if showLH
        if hLines.size() > 0
            line.set_x2(hLines.first(), bar_index)
            line.set_x2(lLines.first(), bar_index)
        hLines.unshift(newLHLine(high))
        lLines.unshift(newLHLine(low))
        while hLines.size() > htfCandleCount
            line.delete(hLines.pop())
        while lLines.size() > htfCandleCount
            line.delete(lLines.pop())
else if htfCandles.size() > 0
    htfCandles.set(0, htfCandles.first().update(high, low, close, bar_index))

[htf2Tf, htf3Tf] = getExtraHTFs()

if showHtf2
    htf2Candles := manageExtraHTF(htf2Candles, htf2Tf, htfCandleCount)
if showHtf3
    htf3Candles := manageExtraHTF(htf3Candles, htf3Tf, htfCandleCount)

if showLH and htfCandles.size() > 0 and hLines.size() > 0
    curCandle = htfCandles.first()
    updateLHLine(hLines.first(), curCandle.h)
    updateLHLine(lLines.first(), curCandle.l)

if periodChanged
    state.prevC2Buy  := c2Buy[1]
    state.prevC2Sell := c2Sell[1]

c2BuyTrigger  = periodChanged and state.prevC2Buy
c2SellTrigger = periodChanged and state.prevC2Sell

if c2BuyTrigger and allowBuy and bullReclaimed[1]
    consumeLastEarlyCisd(bullEarlyCisdRecords)

if c2SellTrigger and allowSell and bearReclaimed[1]
    consumeLastEarlyCisd(bearEarlyCisdRecords)

buySetup  := processC2(c2BuyTrigger, allowBuy, true, state.prevLow, state.prevLowBar, state.prevPrevLow, state.prevPrevLowBar, bullLevelFixed[1], bullIndexFixed[1], bullReclaimed[1], bullReclaimBar[1], buySetup)
sellSetup := processC2(c2SellTrigger, allowSell, false, state.prevHigh, state.prevHighBar, state.prevPrevHigh, state.prevPrevHighBar, bearLevelFixed[1], bearIndexFixed[1], bearReclaimed[1], bearReclaimBar[1], sellSetup)

markTrigger(c2BuyTrigger, allowBuy, 2, true)
markTrigger(c2SellTrigger, allowSell, 2, false)

buySetup  := buySetup.extendAndCheck()
sellSetup := sellSetup.extendAndCheck()

buySetup  := buySetup.checkC4Invalid()
sellSetup := sellSetup.checkC4Invalid()

buySetup  := buySetup.checkCisdConfirm()
sellSetup := sellSetup.checkCisdConfirm()

if showAlerts
    if c2BuyTrigger and allowBuy
        alert('Bullish C2 formed on ' + syminfo.ticker, alert.freq_once_per_bar)
    if c2SellTrigger and allowSell
        alert('Bearish C2 formed on ' + syminfo.ticker, alert.freq_once_per_bar)

if showVlines and periodChanged
    vLines.unshift(line.new(bar_index, low - ta.tr, bar_index, high + ta.tr, xloc.bar_index, extend.both, lineColor, lineStyleFromStr(lineStyle), lineWidth))
    while vLines.size() > htfCandleCount
        line.delete(vLines.pop())
        

//#region [LIQUIDITY LEVELS]

liqPivotHigh = showLiq ? ta.pivothigh(high, liqSwingLen, liqSwingLen) : na
liqPivotLow  = showLiq ? ta.pivotlow(low, liqSwingLen, liqSwingLen) : na
liqPivotBar  = bar_index - liqSwingLen

addLiqLine(array<line> lns, array<label> lbs, array<float> prices, array<bool> swept, float price, int pBar, string txt) =>
    ln = line.new(pBar, price, bar_index, price, xloc.bar_index, extend.none, liqColor, lineStyleFromStr(liqStyleStr), liqWidth)
    lb = liqShowLabel ? label.new(bar_index, price, txt, xloc = xloc.bar_index, style = label.style_label_left, color = na, textcolor = liqColor, size = textSize(liqLabelSize)) : na
    lns.push(ln)
    lbs.push(lb)
    prices.push(price)
    swept.push(false)
    while lns.size() > liqMaxLines
        line.delete(lns.shift())
        oldLbl = lbs.shift()
        if not na(oldLbl)
            label.delete(oldLbl)
        prices.shift()
        swept.shift()

updateLiqLines(array<line> lns, array<label> lbs, array<float> prices, array<bool> swept, bool isBsl) =>
    if lns.size() > 0
        for i = 0 to lns.size() - 1
            if not swept.get(i)
                price = prices.get(i)
                bool breached = isBsl ? high >= price : low <= price
                if breached
                    swept.set(i, true)
                    line.set_x2(lns.get(i), bar_index)
                else
                    line.set_x2(lns.get(i), bar_index)
                    lb = lbs.get(i)
                    if not na(lb)
                        label.set_x(lb, bar_index)

// 1) extend/freeze existing lines first
updateLiqLines(bslLines, bslLabels, bslPrices, bslSwept, true)
updateLiqLines(sslLines, sslLabels, sslPrices, sslSwept, false)

// 2) then add any newly confirmed pivots
if showLiq and not na(liqPivotHigh)
    addLiqLine(bslLines, bslLabels, bslPrices, bslSwept, liqPivotHigh, liqPivotBar, 'BSL')

if showLiq and not na(liqPivotLow)
    addLiqLine(sslLines, sslLabels, sslPrices, sslSwept, liqPivotLow, liqPivotBar, 'SSL')

//#endregion
//#endregion

//#region [PLOT]

if (barstate.islast or barstate.isrealtime) and validTf and htfCandles.size() > 0 and not hideHtf
    n = htfCandles.size()
    for i = n - 1 to 0
        htfCandles.get(i).draw(bar_index + candleOffset + candleSpacing * (n - 1 - i), autoTf)
    if showHtfOpen and not na(htfOpenBar)
        curOpenX2 = box.get_right(htfCandles.first().body)
        if na(htfOpenLn)
            htfOpenLn := line.new(htfOpenBar, currentO, curOpenX2, currentO, xloc.bar_index, extend.none, htfOpenColor, lineStyleFromStr(htfOpenStyle), htfOpenWidth)
        else
            line.set_xy1(htfOpenLn, htfOpenBar, currentO)
            line.set_xy2(htfOpenLn, curOpenX2, currentO)
            line.set_color(htfOpenLn, htfOpenColor)
            line.set_style(htfOpenLn, lineStyleFromStr(htfOpenStyle))
            line.set_width(htfOpenLn, htfOpenWidth)
    if showHtfTf or showHtfTimer
        groupHigh = htfCandles.get(0).h
        for i = 1 to n - 1
            ch = htfCandles.get(i).h
            if ch > groupHigh
                groupHigh := ch
        centerX      = int(math.round((htfCandles.first().midX + htfCandles.get(n - 1).midX) / 2))
        htfCloseTime = time_close(autoTf)
        nowRef       = barstate.isrealtime ? timenow : time_close
        remainingMs  = htfCloseTime - nowRef
        htfMinutesVal = tfMins(autoTf)
        infoParts    = array.new<string>()
        if showHtfTf
            infoParts.push(tfLabel(autoTf))
        if showHtfTimer
            infoParts.push('(' + formatRemaining(remainingMs, htfMinutesVal >= 60) + ')')
        infoText = array.join(infoParts, '\n')
        if na(htfInfoLbl)
            htfInfoLbl := label.new(centerX, groupHigh, infoText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = na, textcolor = htfInfoColor, size = textSize(labelSize), text_font_family = font.family_default)
        else
            label.set_xy(htfInfoLbl, centerX, groupHigh)
            label.set_text(htfInfoLbl, infoText)
            label.set_textcolor(htfInfoLbl, htfInfoColor)
    else if not na(htfInfoLbl)
        label.delete(htfInfoLbl)
        htfInfoLbl := na
    for i = n - 1 to 0
        c = htfCandles.get(i)
        if i > 0
            nextC = htfCandles.get(i - 1)
            line.set_x2(c.eqLine, nextC.midX)
        if showSweep and (c.triggerBuy or c.triggerSell) and i > 0
            nextC = htfCandles.get(i - 1)
            price = c.triggerBuy ? c.l : c.h
            sweepEndX = nextC.midX + 4
            if na(c.sweepLine)
                c.sweepLine := line.new(c.midX, price, sweepEndX, price, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth)
            else
                line.set_xy1(c.sweepLine, c.midX, price)
                line.set_xy2(c.sweepLine, sweepEndX, price)
                line.set_color(c.sweepLine, sweepColor)
                line.set_style(c.sweepLine, lineStyleFromStr(sweepStyle))
                line.set_width(c.sweepLine, sweepWidth)

    int blockGap = 2
    int htf1Right = candleOffset + (htfCandleCount - 1) * candleSpacing + 2
    int htf2Start = htf1Right + blockGap * candleSpacing

    if showHtf2 and not na(htf2Tf) and htf2Candles.size() > 0
        int n2 = htf2Candles.size()
        for i = n2 - 1 to 0
            htf2Candles.get(i).draw(bar_index + htf2Start + candleSpacing * (n2 - 1 - i), htf2Tf)
        float htf2High = htf2Candles.get(0).h
        for i = 1 to n2 - 1
            htf2High := math.max(htf2High, htf2Candles.get(i).h)
        int htf2Center = bar_index + htf2Start + int(candleSpacing * (n2 - 1) / 2)

        string htf2InfoText = tfLabel(htf2Tf)
        if showHtfTimer
            int htf2RemainingMs = time_close(htf2Tf) - (barstate.isrealtime ? timenow : time_close)
            htf2InfoText := htf2InfoText + '\n(' + formatRemaining(htf2RemainingMs, tfMins(htf2Tf) >= 60) + ')'

        if na(htf2InfoLbl)
            htf2InfoLbl := label.new(htf2Center, htf2High, htf2InfoText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = na, textcolor = htfInfoColor, size = textSize(labelSize), text_font_family = font.family_default)
        else
            label.set_xy(htf2InfoLbl, htf2Center, htf2High)
            label.set_text(htf2InfoLbl, htf2InfoText)
            label.set_textcolor(htf2InfoLbl, htfInfoColor)

    
    else if not na(htf2InfoLbl)
        label.delete(htf2InfoLbl)
        htf2InfoLbl := na

    int htf2Right = htf2Start + (htfCandleCount - 1) * candleSpacing + 2
    int htf3Start = htf2Right + blockGap * candleSpacing
    
    if showHtf3 and not na(htf3Tf) and htf3Candles.size() > 0
        int n3 = htf3Candles.size()
        for i = n3 - 1 to 0
            htf3Candles.get(i).draw(bar_index + htf3Start + candleSpacing * (n3 - 1 - i), htf3Tf)
        float htf3High = htf3Candles.get(0).h
        for i = 1 to n3 - 1
            htf3High := math.max(htf3High, htf3Candles.get(i).h)
        int htf3Center = bar_index + htf3Start + int(candleSpacing * (n3 - 1) / 2)

        string htf3InfoText = tfLabel(htf3Tf)
        if showHtfTimer
            int htf3RemainingMs = time_close(htf3Tf) - (barstate.isrealtime ? timenow : time_close)
            htf3InfoText := htf3InfoText + '\n(' + formatRemaining(htf3RemainingMs, tfMins(htf3Tf) >= 60) + ')'

        if na(htf3InfoLbl)
            htf3InfoLbl := label.new(htf3Center, htf3High, htf3InfoText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = na, textcolor = htfInfoColor, size = textSize(labelSize), text_font_family = font.family_default)
        else
            label.set_xy(htf3InfoLbl, htf3Center, htf3High)
            label.set_text(htf3InfoLbl, htf3InfoText)
            label.set_textcolor(htf3InfoLbl, htfInfoColor)

    
    else if not na(htf3InfoLbl)
        label.delete(htf3InfoLbl)
        htf3InfoLbl := na
else
    if not na(htfInfoLbl)
        label.delete(htfInfoLbl)
        htfInfoLbl := na
    if not na(htf2InfoLbl)
        label.delete(htf2InfoLbl)
        htf2InfoLbl := na
    if not na(htf3InfoLbl)
        label.delete(htf3InfoLbl)
        htf3InfoLbl := na

tbl_row_count = 0
tbl_row_count += tbl_show_bias   ? 1 : 0
tbl_row_count += tbl_show_symbol ? 1 : 0
tbl_row_count += tbl_show_model  ? 1 : 0
tbl_row_count += tbl_show_time   ? 1 : 0
tbl_row_count += tbl_show_date   ? 1 : 0

tbl_sz           = textSize(tbl_text_size)
tbl_border_width = tbl_hide_border ? 0 : 1

var table wm = na

if barstate.islast and tbl_show
    if na(wm)
        wm := table.new(tablePosition(tbl_pos_vert, tbl_pos_horiz), 1, math.max(tbl_row_count, 1),
             bgcolor      = tbl_bg_color,
             border_color = tbl_hide_border ? color.new(tbl_bg_color, 100) : tbl_text_color,
             border_width = tbl_border_width,
             frame_color  = tbl_hide_border ? color.new(tbl_bg_color, 100) : tbl_text_color,
             frame_width  = tbl_border_width)

    table.clear(wm, 0, 0, 0, math.max(tbl_row_count, 1) - 1)

    ltfDisp = tfLabel(ltfCode())
    htfDisp = tfLabel(autoTf)

    row = 0

    if tbl_show_bias
        biasColor = biasFilter == 'Bullish' ? color.green : biasFilter == 'Bearish' ? color.red : tbl_text_color
        table.cell(wm, 0, row, 'Bias : ' + biasFilter, text_color = biasColor, bgcolor = tbl_bg_color, text_size = tbl_sz, text_halign = text.align_center, text_font_family = font.family_default)
        row += 1

    if tbl_show_symbol
        table.cell(wm, 0, row, syminfo.ticker, text_color = tbl_text_color, bgcolor = tbl_bg_color, text_size = tbl_sz, text_halign = text.align_center, text_font_family = font.family_default)
        row += 1

    if tbl_show_model
        table.cell(wm, 0, row, ltfDisp + ' - ' + htfDisp + ' Model', text_color = tbl_text_color, bgcolor = tbl_bg_color, text_size = tbl_sz, text_halign = text.align_center, text_font_family = font.family_default)
        row += 1

    if tbl_show_time
        remMs  = time_close(autoTf) - (barstate.isrealtime ? timenow : time_close)
        remStr = barstate.isrealtime ? formatRemaining(remMs, tfMins(autoTf) >= 60) : 'n/a'
        table.cell(wm, 0, row, remStr, text_color = tbl_text_color, bgcolor = tbl_bg_color, text_size = tbl_sz, text_halign = text.align_center, text_font_family = font.family_default)
        row += 1

    if tbl_show_date
        dateStr = str.format_time(time_close, 'MMM dd yyyy', syminfo.timezone)
        table.cell(wm, 0, row, dateStr, text_color = tbl_text_color, bgcolor = tbl_bg_color, text_size = tbl_sz, text_halign = text.align_center, text_font_family = font.family_default)

if not tbl_show and not na(wm)
    table.delete(wm)
    wm := na

// ============================================================
// SMT DIVERGENCE ENGINE — fxstar-style: Auto/Manual Pair + Optional
// Second Pair, both with independent Inverse support and a status label.
// ============================================================
smt_ticker = str.upper(syminfo.ticker)

f_smt_clean_symbol_label(string s) =>
    string[] parts = str.split(s, ":")
    array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : s

f_smt_table_position(string p) =>
    p == "Top Right"    ? position.top_right  :
     p == "Top Left"    ? position.top_left   :
     p == "Bottom Left" ? position.bottom_left :
     p == "Top Center"  ? position.top_center :
     p == "Bottom Center" ? position.bottom_center : position.bottom_right

f_smt_pair_registry(string _ticker) =>
    string p = ""
    if str.contains(_ticker, "MES")
        p := "MNQ1!"
    else if str.contains(_ticker, "MNQ")
        p := "MES1!"
    else if str.contains(_ticker, "MYM")
        p := "MES1!"
    else if str.contains(_ticker, "M2K")
        p := "MES1!"
    else if str.contains(_ticker, "ES")
        p := "NQ1!"
    else if str.contains(_ticker, "NQ")
        p := "ES1!"
    else if str.contains(_ticker, "YM")
        p := "ES1!"
    else if str.contains(_ticker, "RTY")
        p := "ES1!"
    else if str.contains(_ticker, "BTC")
        p := "ETH1!"
    else if str.contains(_ticker, "ETH")
        p := "BTC1!"
    else if str.contains(_ticker, "MGC")
        p := "SIL1!"
    else if str.contains(_ticker, "SIL")
        p := "MGC1!"
    else if str.contains(_ticker, "GC")
        p := "SI1!"
    else if str.contains(_ticker, "SI")
        p := "GC1!"
    else if str.contains(_ticker, "EURUSD")
        p := "GBPUSD"
    else if str.contains(_ticker, "GBPUSD")
        p := "EURUSD"
    else if str.contains(_ticker, "NAS100")
        p := "US500"
    else if str.contains(_ticker, "US500")
        p := "NAS100"
    else if str.contains(_ticker, "GOLD")
        p := "SI1!"
    p

smt_autoPair = f_smt_pair_registry(smt_ticker)
smt_pair1    = smt_useManualPair ? smt_manualPair : smt_autoPair
smt_pair2    = smt_useSecondPair ? smt_secondPair : ""
smt_hasPair  = smt_pair1 != ""
smt_active   = show_smt and smt_hasPair

if show_smt and not smt_hasPair
    runtime.error("No SMT auto pair detected for this chart symbol. Enable Manual and pick a comparison symbol.")

f_smt_pair_tag(string sym, bool inv) =>
    f_smt_clean_symbol_label(sym) + (inv ? " (inv)" : "")

smt_status = not show_smt ? "SMT: Off" :
             not smt_hasPair ? "SMT: Off" :
             smt_useSecondPair ? "SMT: " + f_smt_pair_tag(smt_pair1, smt_pair1_inverse) + " + " + f_smt_pair_tag(smt_pair2, smt_pair2_inverse) :
             "SMT: " + f_smt_pair_tag(smt_pair1, smt_pair1_inverse)

smt_label_pair1 = smt_useSecondPair ? f_smt_pair_tag(smt_pair1, smt_pair1_inverse) : "SMT"
smt_label_pair2 = f_smt_pair_tag(smt_pair2, smt_pair2_inverse)

smt_p1High = smt_active ? request.security(smt_pair1, timeframe.period, high) : na
smt_p1Low  = smt_active ? request.security(smt_pair1, timeframe.period, low) : na
smt_p2High = smt_active and smt_useSecondPair ? request.security(smt_pair2, timeframe.period, high) : na
smt_p2Low  = smt_active and smt_useSecondPair ? request.security(smt_pair2, timeframe.period, low) : na

smt_cPH_raw  = ta.pivothigh(high, smt_swingLen, smt_swingLen)
smt_cPL_raw  = ta.pivotlow(low, smt_swingLen, smt_swingLen)
smt_p1PH_raw = ta.pivothigh(smt_p1High, smt_swingLen, smt_swingLen)
smt_p1PL_raw = ta.pivotlow(smt_p1Low, smt_swingLen, smt_swingLen)
smt_p2PH_raw = ta.pivothigh(smt_p2High, smt_swingLen, smt_swingLen)
smt_p2PL_raw = ta.pivotlow(smt_p2Low, smt_swingLen, smt_swingLen)

smt_cPH  = smt_active ? smt_cPH_raw : na
smt_cPL  = smt_active ? smt_cPL_raw : na
smt_p1PH = smt_active ? smt_p1PH_raw : na
smt_p1PL = smt_active ? smt_p1PL_raw : na
smt_p2PH = smt_active and smt_useSecondPair ? smt_p2PH_raw : na
smt_p2PL = smt_active and smt_useSecondPair ? smt_p2PL_raw : na

smt_pivotBar = bar_index - smt_swingLen

var float[] smt_cHighs = array.new_float()
var int[]   smt_cHighBars = array.new_int()
var float[] smt_cLows = array.new_float()
var int[]   smt_cLowBars = array.new_int()

var float[] smt_p1Highs = array.new_float()
var int[]   smt_p1HighBars = array.new_int()
var float[] smt_p1Lows = array.new_float()
var int[]   smt_p1LowBars = array.new_int()

var float[] smt_p2Highs = array.new_float()
var int[]   smt_p2HighBars = array.new_int()
var float[] smt_p2Lows = array.new_float()
var int[]   smt_p2LowBars = array.new_int()

var line[]  smt_lines = array.new_line()
var label[] smt_labels = array.new_label()
var int[]   smt_bars = array.new_int()
var float[] smt_prices = array.new_float()
var string[] smt_types = array.new_string()
var float[] smt_scores = array.new_float()

f_smt_delete(int _i) =>
    line.delete(array.get(smt_lines, _i))
    label _lb = array.get(smt_labels, _i)
    if not na(_lb)
        label.delete(_lb)
    array.remove(smt_lines, _i)
    array.remove(smt_labels, _i)
    array.remove(smt_bars, _i)
    array.remove(smt_prices, _i)
    array.remove(smt_types, _i)
    array.remove(smt_scores, _i)

f_smt_score(float _a, float _b) =>
    math.abs(_a - _b) / syminfo.mintick

f_smt_line_style(string _style) =>
    _style == "Dashed" ? line.style_dashed : _style == "Dotted" ? line.style_dotted : line.style_solid

f_smt_label_size(string _size) =>
    _size == "Tiny" ? size.tiny : _size == "Normal" ? size.normal : _size == "Large" ? size.large : _size == "Huge" ? size.huge : size.small

f_smt_line_price(int _x1, float _y1, int _x2, float _y2, int _x) =>
    _x2 == _x1 ? _y2 : _y1 + (_y2 - _y1) * (_x - _x1) / (_x2 - _x1)

f_smt_has_overlap(string _type, int _x1, float _y1, int _x2, float _y2) =>
    bool blocked = false
    float buffer = smt_overlapBufferTicks * syminfo.mintick

    if smt_avoidSwingOverlap and _x2 > _x1
        if _type == "Bearish" and array.size(smt_cHighs) > 0
            for j = array.size(smt_cHighs) - 1 to 0
                int b = array.get(smt_cHighBars, j)
                if b > _x1 and b < _x2
                    float swingHigh = array.get(smt_cHighs, j)
                    float lineAtSwing = f_smt_line_price(_x1, _y1, _x2, _y2, b)
                    if swingHigh >= lineAtSwing - buffer
                        blocked := true
                        break

        if _type == "Bullish" and array.size(smt_cLows) > 0
            for j = array.size(smt_cLows) - 1 to 0
                int b = array.get(smt_cLowBars, j)
                if b > _x1 and b < _x2
                    float swingLow = array.get(smt_cLows, j)
                    float lineAtSwing = f_smt_line_price(_x1, _y1, _x2, _y2, b)
                    if swingLow <= lineAtSwing + buffer
                        blocked := true
                        break

    blocked

f_smt_add(string _type, int _x1, float _y1, int _x2, float _y2, float _score, string _txt) =>
    bool skip = _score < smt_minTicks

    if not skip and f_smt_has_overlap(_type, _x1, _y1, _x2, _y2)
        skip := true

    if not skip and smt_mergeNearby and array.size(smt_lines) > 0
        for i = array.size(smt_lines) - 1 to 0
            string oldType = array.get(smt_types, i)
            int oldBar = array.get(smt_bars, i)
            float oldScore = array.get(smt_scores, i)

            if oldType == _type and math.abs(_x2 - oldBar) <= smt_mergeBars
                if _score > oldScore
                    f_smt_delete(i)
                else
                    skip := true
                break

    if not skip
        line ln = line.new(_x1, _y1, _x2, _y2, color=smt_lineColor, width=smt_lineWidth, style=f_smt_line_style(smt_lineStyle))
        label lb = smt_showLabels ? label.new(_x2, _y2, _txt, style=_type == "Bearish" ? label.style_label_down : label.style_label_up, textcolor=smt_labelText, color=smt_labelBg, size=f_smt_label_size(smt_labelSize)) : na

        array.push(smt_lines, ln)
        array.push(smt_labels, lb)
        array.push(smt_bars, _x2)
        array.push(smt_prices, _y2)
        array.push(smt_types, _type)
        array.push(smt_scores, _score)

f_smt_nearest(array<int> _barsArr, array<float> _valsArr, int _targetBar, int _maxDist) =>
    float val = na
    int b = na
    int bestDist = 100000

    if array.size(_barsArr) > 0
        for i = array.size(_barsArr) - 1 to 0
            int swingBar = array.get(_barsArr, i)
            int dist = math.abs(swingBar - _targetBar)

            if dist <= _maxDist and dist < bestDist
                bestDist := dist
                b := swingBar
                val := array.get(_valsArr, i)

    [val, b]

// 1) Store pair pivots first so same-zone pair swings are available.
if smt_active and not na(smt_p1PH)
    array.push(smt_p1Highs, smt_p1PH)
    array.push(smt_p1HighBars, smt_pivotBar)

if smt_active and not na(smt_p1PL)
    array.push(smt_p1Lows, smt_p1PL)
    array.push(smt_p1LowBars, smt_pivotBar)

if smt_active and smt_useSecondPair and not na(smt_p2PH)
    array.push(smt_p2Highs, smt_p2PH)
    array.push(smt_p2HighBars, smt_pivotBar)

if smt_active and smt_useSecondPair and not na(smt_p2PL)
    array.push(smt_p2Lows, smt_p2PL)
    array.push(smt_p2LowBars, smt_pivotBar)

// _pHighs/_pHighBars and _pLows/_pLowBars are the pair's full pivot-high and pivot-low
// histories. On a normal (positively correlated) pair, a bearish divergence is confirmed
// against the pair's HIGHS (it should also break higher). On an INVERSE pair (e.g. DXY vs
// EURUSD), the pair is expected to move the opposite way, so confirmation is checked
// against the pair's LOWS instead (it should be making a fresh low while chart makes a
// fresh high) — a divergence is when that expected opposite move fails to happen.
f_smt_detect_bearish(float _curChartHigh, int _curChartBar, array<float> _pHighs, array<int> _pHighBars, array<float> _pLows, array<int> _pLowBars, bool _inverse, string _txt) =>
    array<float> pSeries     = _inverse ? _pLows : _pHighs
    array<int>   pSeriesBars = _inverse ? _pLowBars : _pHighBars

    if array.size(smt_cHighs) > 0 and array.size(pSeries) > 1
        [curPairVal, curPairBar] = f_smt_nearest(pSeriesBars, pSeries, _curChartBar, smt_pairLagBars)

        if not na(curPairVal)
            float bestScore = na
            int bestBar = na
            float bestPrice = na

            for i = array.size(smt_cHighs) - 1 to 0
                int refChartBar = array.get(smt_cHighBars, i)

                if _curChartBar > refChartBar and _curChartBar - refChartBar <= smt_lookback
                    float refChartHigh = array.get(smt_cHighs, i)
                    [refPairVal, refPairBar] = f_smt_nearest(pSeriesBars, pSeries, refChartBar, smt_pairLagBars)

                    if not na(refPairVal)
                        bool chartBreak = _curChartHigh > refChartHigh
                        // Normal: pair should also break higher. Inverse: pair should break lower.
                        bool pairBreak  = _inverse ? (curPairVal < refPairVal) : (curPairVal > refPairVal)

                        if chartBreak != pairBreak
                            float pairMoveScore = math.abs(curPairVal - refPairVal) / syminfo.mintick
                            float score = math.max(f_smt_score(_curChartHigh, refChartHigh), pairMoveScore)

                            if na(bestScore) or score > bestScore
                                bestScore := score
                                bestBar := refChartBar
                                bestPrice := refChartHigh

            if not na(bestScore)
                f_smt_add("Bearish", bestBar, bestPrice, _curChartBar, _curChartHigh, bestScore, _txt)

f_smt_detect_bullish(float _curChartLow, int _curChartBar, array<float> _pHighs, array<int> _pHighBars, array<float> _pLows, array<int> _pLowBars, bool _inverse, string _txt) =>
    array<float> pSeries     = _inverse ? _pHighs : _pLows
    array<int>   pSeriesBars = _inverse ? _pHighBars : _pLowBars

    if array.size(smt_cLows) > 0 and array.size(pSeries) > 1
        [curPairVal, curPairBar] = f_smt_nearest(pSeriesBars, pSeries, _curChartBar, smt_pairLagBars)

        if not na(curPairVal)
            float bestScore = na
            int bestBar = na
            float bestPrice = na

            for i = array.size(smt_cLows) - 1 to 0
                int refChartBar = array.get(smt_cLowBars, i)

                if _curChartBar > refChartBar and _curChartBar - refChartBar <= smt_lookback
                    float refChartLow = array.get(smt_cLows, i)
                    [refPairVal, refPairBar] = f_smt_nearest(pSeriesBars, pSeries, refChartBar, smt_pairLagBars)

                    if not na(refPairVal)
                        bool chartBreak = _curChartLow < refChartLow
                        // Normal: pair should also break lower. Inverse: pair should break higher.
                        bool pairBreak  = _inverse ? (curPairVal > refPairVal) : (curPairVal < refPairVal)

                        if chartBreak != pairBreak
                            float pairMoveScore = math.abs(curPairVal - refPairVal) / syminfo.mintick
                            float score = math.max(f_smt_score(_curChartLow, refChartLow), pairMoveScore)

                            if na(bestScore) or score > bestScore
                                bestScore := score
                                bestBar := refChartBar
                                bestPrice := refChartLow

            if not na(bestScore)
                f_smt_add("Bullish", bestBar, bestPrice, _curChartBar, _curChartLow, bestScore, _txt)

// 2) Run detection (arrays are now populated)
if smt_active and not na(smt_cPH)
    f_smt_detect_bearish(smt_cPH, smt_pivotBar, smt_p1Highs, smt_p1HighBars, smt_p1Lows, smt_p1LowBars, smt_pair1_inverse, smt_label_pair1)
    if smt_useSecondPair
        f_smt_detect_bearish(smt_cPH, smt_pivotBar, smt_p2Highs, smt_p2HighBars, smt_p2Lows, smt_p2LowBars, smt_pair2_inverse, smt_label_pair2)

if smt_active and not na(smt_cPL)
    f_smt_detect_bullish(smt_cPL, smt_pivotBar, smt_p1Highs, smt_p1HighBars, smt_p1Lows, smt_p1LowBars, smt_pair1_inverse, smt_label_pair1)
    if smt_useSecondPair
        f_smt_detect_bullish(smt_cPL, smt_pivotBar, smt_p2Highs, smt_p2HighBars, smt_p2Lows, smt_p2LowBars, smt_pair2_inverse, smt_label_pair2)

// 3) Store current chart pivots (for the next bar's detection)
if smt_active and not na(smt_cPH)
    array.push(smt_cHighs, smt_cPH)
    array.push(smt_cHighBars, smt_pivotBar)

if smt_active and not na(smt_cPL)
    array.push(smt_cLows, smt_cPL)
    array.push(smt_cLowBars, smt_pivotBar)

smt_maxSwings = 150

if array.size(smt_cHighs) > smt_maxSwings
    array.shift(smt_cHighs)
    array.shift(smt_cHighBars)

if array.size(smt_cLows) > smt_maxSwings
    array.shift(smt_cLows)
    array.shift(smt_cLowBars)

if array.size(smt_p1Highs) > smt_maxSwings
    array.shift(smt_p1Highs)
    array.shift(smt_p1HighBars)

if array.size(smt_p1Lows) > smt_maxSwings
    array.shift(smt_p1Lows)
    array.shift(smt_p1LowBars)

if array.size(smt_p2Highs) > smt_maxSwings
    array.shift(smt_p2Highs)
    array.shift(smt_p2HighBars)

if array.size(smt_p2Lows) > smt_maxSwings
    array.shift(smt_p2Lows)
    array.shift(smt_p2LowBars)

if smt_active and smt_deleteInvalid and array.size(smt_lines) > 0
    for i = array.size(smt_lines) - 1 to 0
        string typ = array.get(smt_types, i)
        float lvl = array.get(smt_prices, i)

        bool bearInvalid = typ == "Bearish" and (smt_invalOnClose ? close > lvl : high > lvl)
        bool bullInvalid = typ == "Bullish" and (smt_invalOnClose ? close < lvl : low < lvl)

        if bearInvalid or bullInvalid
            f_smt_delete(i)

// ============================================================
// SMT STATUS LABEL
// ============================================================
var table smt_info_tbl = na
if show_smt_info
    if na(smt_info_tbl)
        smt_info_tbl := table.new(f_smt_table_position(smt_info_pos), 1, 1, bgcolor=smt_info_bg_c, frame_width=0, border_width=0)
    table.cell(smt_info_tbl, 0, 0, smt_status, text_size=smt_info_size, text_halign=text.align_center, text_valign=text.align_center, text_color=smt_info_text_c, bgcolor=smt_info_bg_c)

alertcondition(smt_active, "SMT Divergence", "SMT divergence engine running")

//#endregion
