smt_deleteInvalid  = input.bool(false, "Delete Invalidated SMT", group=GRP_SMT)
smt_invalOnClose   = input.bool(false, "Invalidate Only On Close", group=GRP_SMT)

smt_minTicks           = 2.0
smt_overlapBufferTicks = 2.0
smt_avoidSwingOverlap  = true

smt_lineColor = input.color(color.purple, "Color", group=GRP_SMT, inline="smtline")
smt_lineWidth = input.int(1, "Width", minval=1, maxval=5, group=GRP_SMT, inline="smtline")
