bearBody   = input.color(color.rgb(46, 46, 46), group = grpCandles, inline = 'body')
borderBull = input.color(color.rgb(46, 46, 46), 'Borders', group = grpCandles, inline = 'border')
borderBear = input.color(color.rgb(46, 46, 46), group = grpCandles, inline = 'border')
wickBull   = input.color(color.rgb(46, 46, 46), 'Wick', group = grpCandles, inline = 'wick')
wickBear   = input.color(color.rgb(46, 46, 46), group = grpCandles, inline = 'wick')

showHtfOpen  = input.bool(false, 'HTF Open', group = grpCandles, inline = 'htfopen')
htfOpenColor = input.color(color.new(#1a1a1a, 30), '', group = grpCandles, inline = 'htfopen')
htfOpenStyle = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpCandles, inline = 'htfopen')
