smt_pair1_inverse   = input.bool(false, "Inverse?", group=GRP_SMT, inline="smtmain",
     tooltip="Turn on for negatively-correlated pairs (e.g. DXY vs EURUSD, VIX vs SPX). When on, a bearish divergence is confirmed by the comparison symbol making a fresh LOW (not a failed high), and a bullish divergence by it making a fresh HIGH (not a failed low).")

smt_swingLen       = input.int(3, "Swing Length", minval=1, group=GRP_SMT)
smt_lookback       = input.int(200, "Structure Lookback Bars", minval=10, group=GRP_SMT)
smt_pairLagBars    = input.int(1, "Max Pair Swing Distance", minval=1, group=GRP_SMT)
smt_mergeNearby    = input.bool(true, "Merge Nearby SMTs", group=GRP_SMT)
