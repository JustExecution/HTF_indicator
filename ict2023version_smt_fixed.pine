showHtfTf     = input.bool(true, 'HTF Info', group = grpCandles, inline = 'htfinfo', tooltip = 'Shows the higher timeframe label and/or a countdown to the close of the live HTF candle, centered above the block of HTF candles.')
showHtfTimer  = input.bool(true, 'Countdown', group = grpCandles, inline = 'htfinfo')
showHtfStamps = input.bool(false, 'Time Stamps', group = grpCandles, inline = 'htfinfo', tooltip = 'Shows the open time (or day name for daily+ candles) under each individual HTF candle.')
htfInfoColor  = input.color(color.new(#1a1a1a, 0), '', group = grpCandles, inline = 'htfinfo')

showVlines = input.bool(false, 'O/C Time', group = grpCandles, inline = 'vline')
lineColor  = input.color(color.new(color.gray, 60), '', group = grpCandles, inline = 'vline')
lineStyle  = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], group = grpCandles, inline = 'vline')
lineWidth  = input.int(1, '', minval = 1, group = grpCandles, inline = 'vline')

showLH  = input.bool(false, 'L/H Lines', group = grpCandles, inline = 'lh')
