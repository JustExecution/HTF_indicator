//@version=6
indicator("Liquidity Suite - Sessions + BSL/SSL", shorttitle="LiqSuite", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=500)

// ================================================================================================
// LIQUIDITY SUITE
// Sessions (Asia/London/NY) + True Day Open + PDH/PDL/PWH/PWL/PMH/PML + 3-tier HTF BSL/SSL
// + Relevant Swings (fractal range map), all reconciled through one declutter engine.
//
// PRIORITY (1 = highest; used only as a tie-break and the HTF-vs-LTF gate):
//   1 PDH/PDL/PWH/PWL/PMH/PML   2 Sessions H/L            3 HTF3 BSL/SSL
//   4 HTF2 BSL/SSL              5 HTF1 BSL/SSL            6 Relevant Swings (current TF)
//
// When "Show Only Relevant Levels" is ON, any level whose price sits within
// (ATR x Proximity Mult) of another level is hidden (fully transparent, object kept
// alive so its own touch/purge logic keeps working) - not merged, not deleted, just
// hidden. Clash rules, in order:
//   1. A purged (already-touched, ✕) level always loses to a fresh active level.
//   2. An HTF level (prio 1-5) always beats a current-TF swing (prio 6).
//   3. Otherwise the OLDEST level (earliest formation bar) wins the cluster.
//   4. Equal age -> higher priority, then registration order.
//
// The currently-forming session is NOT reconciled (it is unconfirmed): it can
// neither hide nor be hidden, and joins the filter once it closes.
//
// RELEVANT SWINGS use a fractal window (default 3 candles of the next higher
// timeframe, auto-mapped: 5m->1H, 15m->4H, 1H->D, D->M); pivots inside the window
// are separated by the swings' own ATR (default 10, independent of the filter ATR)
// so only major levels remain - a range map of the current TF for liq-sweep /
// consolidation detection. At most the configured max levels per side are shown
// (default 5).
//
// PURGED LEVELS (universal): every level type (PD/PW/PM, sessions H/L, HTF BSL/SSL,
// swings) gets a ✕ cross at the touch point. BSL/SSL-type levels (PD/PW/PM + HTF)
// are deleted ("Delete Purged Levels") or kept as gray/dotted; sessions H/L are never
// deleted. Purged lines stay inside the declutter engine, so the ATR relevance filter
// hides them too.
// ================================================================================================

// ============================================================
// GROUPS
// ============================================================
var string GRP_GEN   = "General"
var string GRP_REL   = "Relevance Filter"
var string GRP_SESS  = "Sessions"
var string GRP_TDO   = "True Day Open"
var string GRP_PDW   = "PDH/PDL - PWH/PWL - PMH/PML"
var string GRP_H1    = "HTF1 BSL/SSL"
var string GRP_H2    = "HTF2 BSL/SSL"
var string GRP_H3    = "HTF3 BSL/SSL"
var string GRP_PRG   = "Purged Levels"
var string GRP_SW    = "Relevant Swings"

// ============================================================
// GENERAL
// ============================================================
session_tz = input.string("America/New_York", "Timezone", group=GRP_GEN)

// ============================================================
// RELEVANCE FILTER
// ============================================================
mark_relevant_only = input.bool(false, "Show Only Relevant Levels", group=GRP_REL,
     tooltip="When on, levels that sit within (ATR x Mult) of another level are decluttered: a purged (already-touched) level always loses to a fresh one, an HTF level always beats a current-TF swing, and otherwise the OLDEST level in the cluster is kept. The currently-forming session is exempt.")
atr_len   = input.int(25, "ATR Length", minval=1, group=GRP_REL,
     tooltip="ATR is computed on the current chart timeframe (auto).")
atr_mult  = input.float(0.5, "Proximity Threshold (x ATR)", minval=0.05, step=0.05, group=GRP_REL,
     tooltip="Two levels closer together than this many ATRs are treated as 'the same level'.")

// ============================================================
// SESSION SETTINGS
// ============================================================
show_sessions = input.bool(true, "Show Sessions", group=GRP_SESS)
hide_above_tf = input.timeframe("30", "Hide Sessions Above TF", group=GRP_SESS)
alert_sessions = input.bool(true, "Alert on Session High/Low Break", group=GRP_SESS)

draw_style   = input.string("Both", "Style", group=GRP_SESS, options=["Box", "Lines", "Both"])
box_transp   = input.int(92, "Box Transparency", group=GRP_SESS, minval=0, maxval=100)
session_lbl  = input.string("Small", "Label Size", options=["Hide", "Tiny", "Small", "Normal", "Large", "Huge", "Auto"], group=GRP_SESS)
max_sessions = input.int(3, "Max Past Sessions to Show", group=GRP_SESS, minval=1, maxval=20)
session_style = input.string('⎯⎯⎯', 'Line Style', inline='ses_st', group=GRP_SESS, options=['⎯⎯⎯', '----', '····'])
session_width = input.int(1, 'Line Width', inline='ses_st', group=GRP_SESS, minval=1, maxval=5)

use_asia     = input.bool(true, "Asia", inline="s_as", group=GRP_SESS)
asia_session = input.session("2000-0000", "", inline="s_as", group=GRP_SESS)
asia_color   = input.color(color.rgb(238, 181, 107), "", inline="s_as", group=GRP_SESS)
asia_hi_txt  = input.string("A.H", "High Label", group=GRP_SESS, inline="s_as_t")
asia_lo_txt  = input.string("A.L", "Low Label", group=GRP_SESS, inline="s_as_t")

use_london     = input.bool(true, "London", inline="s_lo", group=GRP_SESS)
london_session = input.session("0200-0500", "", inline="s_lo", group=GRP_SESS)
london_color   = input.color(color.rgb(82, 64, 120), "", inline="s_lo", group=GRP_SESS)
london_hi_txt  = input.string("L.H", "High Label", group=GRP_SESS, inline="s_lo_t")
london_lo_txt  = input.string("L.L", "Low Label", group=GRP_SESS, inline="s_lo_t")

use_ny     = input.bool(true, "New York", inline="s_ny", group=GRP_SESS)
