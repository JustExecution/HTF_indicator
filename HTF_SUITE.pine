 tf_sec == 300   ? "1D"  :
 tf_sec == 900   ? "1W"  :
 tf_sec == 1800  ? "1W"  :
 tf_sec == 3600  ? "1M"  :
 tf_sec == 7200  ? "1M"  :
 tf_sec == 14400 ? "1M"  :
 tf_sec == 86400 ? "1M"  :
 is_1w_chart     ? "3M"  : "1W"

