// ============================================================
// HELPERS
// ============================================================
f_style(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid
f_clean_symbol_label(string s) =>
    string[] parts = str.split(s, ":")
    array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : s

f_tf_label(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec < 3600 ? str.tostring(math.round(sec / 60)) + "m" :
     sec < 86400 and sec % 3600 != 0 ? str.tostring(math.round(sec / 60)) + "m" :
     sec < 86400 ? str.tostring(math.round(sec / 3600)) + "H" :
     sec == 86400 ? "1D" : sec == 604800 ? "1W" : tf

f_mid_time(int t, int ms) =>
    t + math.round(ms / 2)

f_pad2(int n) =>
    n < 10 ? "0" + str.tostring(n) : str.tostring(n)

f_countdown_string(int close_t) =>
    int seconds_left = math.max(0, math.round((close_t - timenow) / 1000))
    int hh = math.floor(seconds_left / 3600)
    int mm = math.floor((seconds_left % 3600) / 60)
    int ss = seconds_left % 60
    f_pad2(hh) + ":" + f_pad2(mm) + ":" + f_pad2(ss)

f_date_string(int t) =>
    f_pad2(month(t)) + "/" + f_pad2(dayofmonth(t)) + "/" + f_pad2(year(t) % 100)

f_table_position(string p) =>
    p == "Top Right"    ? position.top_right  :
     p == "Top Left"    ? position.top_left   :
     p == "Bottom Left" ? position.bottom_left :
     p == "Top Center"  ? position.top_center :
     p == "Bottom Center" ? position.bottom_center : position.bottom_right

// ============================================================
// SESSION STATE — must declare before fractal logic
// ============================================================
var string SESS_TZ = "America/New_York"

var box[]  asia_boxes   = array.new<box>()
var line[] asia_hi      = array.new<line>()
var line[] asia_lo      = array.new<line>()

var box[]  london_boxes = array.new<box>()
var line[] london_hi    = array.new<line>()
var line[] london_lo    = array.new<line>()

var box[]  ny_boxes     = array.new<box>()
var line[] ny_hi        = array.new<line>()
var line[] ny_lo        = array.new<line>()

var line[] tdo_lines    = array.new<line>()
var int[]  tdo_days     = array.new<int>()  // tracks which day each TDO belongs to
// ============================================================
// SESSION HELPER FUNCTIONS
// ============================================================
f_sess_line_style(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_sess_manage(bool use, string sess, string lbl, color col, box[] bx_arr, line[] hi_arr, line[] lo_arr) =>
    if use and timeframe.in_seconds() < timeframe.in_seconds(sess_tf_limit)
        bool in_now  = not na(time("", sess, SESS_TZ))
        bool in_prev = not na(time("", sess, SESS_TZ)[1])
        color fill   = color.new(col, sess_box_transp)

        // Session just opened
        if in_now and not in_prev
            if sess_draw_type == "Box"
                bx_arr.unshift(box.new(time, high, time, low, xloc=xloc.bar_time, 
                     border_color=fill, bgcolor=fill,
                     text=sess_show_label ? lbl : "",
                     text_color=color.new(col, 0), text_size=size.small, text_halign=text.align_left))
                // Cleanup old sessions
                if sess_show_only_current
                    while bx_arr.size() > 1
                        bx_arr.pop().delete()
                else
                    while bx_arr.size() > sess_max_history
                        bx_arr.pop().delete()
            else
                hi_arr.unshift(line.new(time, high, time, high, xloc=xloc.bar_time, color=col, width=1))
                lo_arr.unshift(line.new(time, low, time, low, xloc=xloc.bar_time, color=col, width=1))
                // Cleanup old lines
                if sess_show_only_current
                    while hi_arr.size() > 1
                        hi_arr.pop().delete()
                        lo_arr.pop().delete()
                else
                    while hi_arr.size() > sess_max_history
                        hi_arr.pop().delete()
                        lo_arr.pop().delete()

        // Session is open: expand drawing
        if in_now
            if sess_draw_type == "Box" and bx_arr.size() > 0
                b = bx_arr.get(0)
                b.set_right(time)
                b.set_top(math.max(b.get_top(), high))
                b.set_bottom(math.min(b.get_bottom(), low))
            else if sess_draw_type == "Lines" and hi_arr.size() > 0
                h_ln = hi_arr.get(0)
                l_ln = lo_arr.get(0)
                h_ln.set_x2(time)
                l_ln.set_x2(time)
                if high > h_ln.get_y1()
                    h_ln.set_xy1(time, high)
                    h_ln.set_xy2(time, high)
                if low < l_ln.get_y1()
                    l_ln.set_xy1(time, low)
                    l_ln.set_xy2(time, low)
f_true_day_open() =>
    if use_true_open and timeframe.in_seconds() < timeframe.in_seconds(sess_tf_limit)
        bool is_midnight  = not na(time("", "0000-0001", SESS_TZ))
        bool was_midnight = not na(time("", "0000-0001", SESS_TZ)[1])
        int current_day = dayofmonth(time, SESS_TZ)
        
        // New day detected
        if is_midnight and not was_midnight
            tdo_lines.unshift(line.new(time, open, time, open, xloc=xloc.bar_time, 
                 color=tdo_color, style=f_sess_line_style(tdo_style), width=tdo_width))
            tdo_days.unshift(current_day)
            
            // Cleanup: keep only current + user-selected previous days
            int keep_count = 1 + (tdo_show_prev ? tdo_prev_count : 0)
            if tdo_lines.size() > keep_count
                tdo_lines.pop().delete()
                tdo_days.pop()
        
        // Extend all active TDO lines to current bar
        if tdo_lines.size() > 0
            for i = 0 to tdo_lines.size() - 1
                tdo_lines.get(i).set_x2(time)


// ============================================================
// AUTO FRACTAL MAP — Dual HTF, 5 Modes
// ============================================================
int  tf_sec      = timeframe.in_seconds()
bool is_1w_chart = timeframe.isweekly  and timeframe.multiplier == 1
bool is_1m_chart = timeframe.ismonthly and timeframe.multiplier == 1

// ----------------------------------------------------------------
// AUTOMATIC — original fractal chain extended one level up
// Examples: 1m → 15m → 4H   |   3m → 30m → 90m   |   1H → 1D → 1W
// ----------------------------------------------------------------
string auto_htf1 =
 tf_sec == 60    ? "15"  :
 tf_sec == 120   ? "15"  :
 tf_sec == 180   ? "30"  :
 tf_sec == 300   ? "60"  :
 tf_sec == 900   ? "240" :
 tf_sec == 1800  ? "90"  :
 tf_sec == 3600  ? "1D"  :
 tf_sec == 14400 ? "1W"  :
 tf_sec == 86400 ? "1M"  :
 is_1w_chart     ? "3M"  :
 is_1m_chart     ? "6M"  :
 tf_sec < 3600   ? "60"  : "1D"

string auto_htf2 =
 tf_sec == 60    ? "240" :   // 1m  → 15m  → 4H
 tf_sec == 120   ? "240" :   // 2m  → 15m  → 4H
 tf_sec == 180   ? "90"  :   // 3m  → 30m  → 90m
 tf_sec == 300   ? "240" :   // 5m  → 60m  → 4H
 tf_sec == 900   ? "1D"  :   // 15m → 4H   → 1D
 tf_sec == 1800  ? "240" :   // 30m → 90m  → 4H
 tf_sec == 3600  ? "1W"  :   // 1H  → 1D   → 1W
 tf_sec == 14400 ? "1M"  :   // 4H  → 1W   → 1M
 tf_sec == 86400 ? "3M"  :   // 1D  → 1M   → 3M
 is_1w_chart     ? "12M" :   // 1W  → 3M   → 12M
 is_1m_chart     ? "12M" :   // 1M  → 6M   → 12M
 tf_sec < 3600   ? "240" : "1W"

// ----------------------------------------------------------------
// INTRADAY — optimised for same-day structure
// ----------------------------------------------------------------
string intra_htf1 =
 tf_sec == 60    ? "15"  :
 tf_sec == 180   ? "30"  :
 tf_sec == 300   ? "60"  :
 tf_sec == 900   ? "240" :
 tf_sec == 1800  ? "240" :
 tf_sec == 3600  ? "1D"  :
 tf_sec == 7200  ? "1D"  :
 tf_sec == 14400 ? "1D"  :
 tf_sec == 86400 ? "1W"  : "60"

string intra_htf2 =
 tf_sec == 60    ? "60"  :
 tf_sec == 180   ? "240" :
 tf_sec == 300   ? "1D"  :
 tf_sec == 900   ? "1D"  :
 tf_sec == 1800  ? "1D"  :
 tf_sec == 3600  ? "1W"  :
 tf_sec == 7200  ? "1W"  :
 tf_sec == 14400 ? "1W"  :
 tf_sec == 86400 ? "1M"  : "1D"

// ----------------------------------------------------------------
// SCALP — tight micro-structure context
// ----------------------------------------------------------------
string scalp_htf1 =
 tf_sec <= 60    ? "5"   :
 tf_sec <= 300   ? "15"  :
 tf_sec <= 900   ? "60"  :
 tf_sec <= 3600  ? "240" : "1D"

string scalp_htf2 =
 tf_sec <= 60    ? "15"  :
 tf_sec <= 300   ? "60"  :
 tf_sec <= 900   ? "240" :
 tf_sec <= 3600  ? "1D"  : "1W"

// ----------------------------------------------------------------
// SWING — broad market structure
// ----------------------------------------------------------------
string swing_htf1 =
 tf_sec == 300   ? "60"  :
 tf_sec == 900   ? "240" :
 tf_sec == 1800  ? "240" :
 tf_sec == 3600  ? "1D"  :
 tf_sec == 7200  ? "1D"  :
 tf_sec == 14400 ? "1W"  :
 tf_sec == 86400 ? "1W"  :
 is_1w_chart     ? "1M"  : "1D"

