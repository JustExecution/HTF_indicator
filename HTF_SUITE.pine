string htf =
 fractal_mode == "Custom"   ? custom_htf  :
 fractal_mode == "Intraday" ? intra_htf1  :
 fractal_mode == "Scalp"    ? scalp_htf1  :
 fractal_mode == "Swing"    ? swing_htf1  : auto_htf1

