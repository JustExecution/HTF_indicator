[smt_sym2_h, smt_sym2_l] = request.security(smt_sym2_resolved, "", [high, low], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

var SMT_Tracker smt_tracker1 = SMT_Tracker.new()
