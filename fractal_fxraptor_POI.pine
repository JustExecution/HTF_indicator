htf2_gap_input                  = input.int(6, 'Gap from HTF1', minval = 0, group = group_htf2, tooltip = 'Extra horizontal spacing between the HTF1 candle cluster and the HTF2 candle cluster.', active = htf2_show_input)
htf2_mode_input                 = input.string('Automatic', 'HTF2 Mode', options = ['Automatic', 'Custom'], group = group_htf2, active = htf2_show_input, tooltip = 'Automatic: one step above HTF1, auto re-aligned to chart TF.\nCustom: pin HTF2 manually.')
htf2_custom_input               = input.timeframe('1D', 'Custom HTF2', group = group_htf2, active = htf2_show_input and htf2_mode_input == 'Custom')

// HTF2 Label Settings
htf2_label_show_input           = input.bool(true, 'HTF2 Label     ', group=group_label, inline='HTF2lbl')
htf2_label_color_input          = input.color(color.rgb(0, 0, 0), '', group=group_label, inline='HTF2lbl', active = htf2_label_show_input and htf2_show_input)
htf2_label_size_input           = input.string(size.large, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline='HTF2lbl', active = htf2_label_show_input and htf2_show_input)
htf2_label_position_input       = input.string("Top", 'Pos', options=['Both', 'Top', 'Bottom'], group=group_label, inline='HTF2lbl', active = htf2_label_show_input and htf2_show_input)
htf2_timer_show_input           = input.bool(true, 'Remaining Time', inline='timer2', group=group_label, active = htf2_label_show_input and htf2_show_input)
htf2_timer_color_input          = input.color(color.rgb(0, 0, 0), '', inline='timer2', group=group_label, active = htf2_timer_show_input and htf2_label_show_input and htf2_show_input)
htf2_timer_size_input           = input.string(size.normal, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline='timer2', active = htf2_timer_show_input and htf2_label_show_input and htf2_show_input)

getAutoHTF2() =>
    int s = timeframe.in_seconds()
    bool is1W = timeframe.isweekly and timeframe.multiplier == 1
    bool is1M = timeframe.ismonthly and timeframe.multiplier == 1
    switch
        s == 60    => '240'
        s == 120   => '240'
        s == 180   => '90'
        s == 300   => '240'
        s == 900   => '1D'
        s == 1800  => '240'
        s == 3600  => '1W'
        s == 14400 => '1M'
        s == 86400 => '3M'
        is1W       => '12M'
        is1M       => '12M'
        s < 3600   => '240'
        => '1W'

getHTF2() =>
    switch htf2_mode_input
        "Custom" => htf2_custom_input
        => getAutoHTF2()

