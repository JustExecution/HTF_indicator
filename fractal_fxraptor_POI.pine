settings.proj_label_show        := proj_label_show_input
settings.proj_label_size        := input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large', 'Huge'], inline='proj_lbl', group=group_projection, active = proj_label_show_input and proj_show_input)
settings.proj_type              := input.string('Wick', 'Type          ', options=['Body', 'Wick'], inline='proj_type', group=group_projection, active = proj_show_input)
proj_deviations_input           = input.string("0,1,-1,-2,-2.5", '', inline='proj_type', group=group_projection, tooltip='Comma-separated list of deviation levels to draw', active = proj_show_input)
settings.proj_color             := input.color(color.rgb(0,0,0,80), '', inline='proj_style', group=group_projection, active = proj_show_input)
settings.proj_style             := input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='proj_style', group=group_projection, active = proj_show_input)
settings.proj_width             := input.int(1, 'Width', inline='proj_style', group=group_projection, active = proj_show_input)

// Parse deviation levels (comma-separated)
if proj_deviations.size() == 0
    string[] parts = str.split(proj_deviations_input, ",")
    for i = 0 to parts.size() - 1
        float val = str.tonumber(str.trim(parts.get(i)))
        if not na(val)
            proj_deviations.push(val)

